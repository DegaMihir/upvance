{
  "manifest_version": 3,
  "name": "Upvance Assistant",
  "short_name": "Upvance",
  "version": "1.0.0",
  "description": "Send the job you're viewing to your local Upvance app, see your match, fill employer forms from your approved package, and draft recruiter messages.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Upvance", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "options_page": "options.html",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"]
}
