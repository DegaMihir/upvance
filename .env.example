# Copy this file to .env and fill in what you have. Never commit .env.

# --- App ---
PORT=3100
DATABASE_URL="file:./dev.db"
# Random secrets. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
APP_ENCRYPTION_KEY=
AUTH_TRUST_HOST=true

# --- AI providers: gemini | groq | openrouter | anthropic | none ---
ANALYSIS_PROVIDER=gemini
WRITING_PROVIDER=gemini
# Used automatically when the main provider hits a rate limit
AI_FALLBACK_PROVIDER=groq
# Max AI requests per day per provider (keeps you inside free tiers)
AI_DAILY_LIMIT=200

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Used automatically when the main Gemini model is overloaded (503) or slow
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Optional job source ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Phase 4 (all optional) ---
# Google Jobs results via SerpApi (serpapi.com)
SERPAPI_KEY=
# Gmail sign-in (read-only) instead of an app password – create OAuth credentials in Google Cloud Console,
# redirect URI: http://localhost:3100/api/inbox/gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Max jobs imported per job board (default 150)
BOARD_MAX_JOBS=150
# Set to 1 to make the apply engine ALWAYS stop before Submit (safe trial mode)
APPLY_ENGINE_DRY_RUN=0
